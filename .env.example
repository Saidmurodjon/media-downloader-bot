# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# Webhook URL (required for webhook mode)
WEBHOOK_URL=https://your-domain.com

# Port for the HTTP server (default: 3000)
PORT=3000

# Path to SQLite database file (default: ./data.db)
DB_PATH=./data.db

# Max file size in MB for downloads (default: 50)
MAX_FILE_SIZE_MB=50

# Temp directory for downloads (default: ./tmp)
TEMP_DIR=./tmp

# Minutes before cleaning up temp files (default: 60)
TEMP_TTL_MINUTES=60
